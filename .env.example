# Copy to .env and fill in. Values become -D build flags via load_env.py.
# Wi-Fi network seeded into the on-watch list on first boot (NVS); optional.
WIFI_SSID=MyNetwork
WIFI_PASSWD=secret
# Default timezone offset in seconds (changeable later in the watch menu). 7200 = UTC+2
GMT_OFFSET_SEC=0
# OpenWeatherMap API key (https://openweathermap.org/api); without it the face shows the internal temperature sensor
OPENWEATHERMAP_APIKEY=
# Optional: OpenWeatherMap city id (https://openweathermap.org/current#cityid).
# 5128581 = New York, 554234 = Kaliningrad
CITY_ID=5128581
# Optional: weather units, metric|imperial
TEMP_UNIT=metric
# Optional: language of the weather description
TEMP_LANG=en
# UI language: en ru de es fr pt (one per build)
LANG=en
# Short vibration every full hour: 1 = on (default), 0 = off
VIBRATE_OCLOCK=1
# Auto-dismiss a ringing alarm after this many minutes (default 5;
# the countdown restarts after each snooze)
ALARM_RING_MIN=5
