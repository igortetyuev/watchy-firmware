# Copy to .env and fill in. Values become -D build flags via load_env.py.
# Wi-Fi network seeded into the on-watch list on first boot (NVS); optional.
WIFI_SSID=MyNetwork
WIFI_PASSWD=secret
# Default timezone offset in seconds (changeable later in the watch menu). 7200 = UTC+2
GMT_OFFSET_SEC=0
# OpenWeatherMap API key (https://openweathermap.org/api); without it the face shows the internal temperature sensor
OPENWEATHERMAP_APIKEY=
# Optional: OpenWeatherMap city id (https://openweathermap.org/current#cityid).
# 5128581 = New York, 554234 = Kaliningrad
CITY_ID=5128581
# Optional: weather units, metric|imperial
TEMP_UNIT=metric
# Optional: language of the weather description
TEMP_LANG=en
# UI language: en ru de es fr pt (one per build)
LANG=en
# Short vibration every full hour: 1 = on (default), 0 = off
VIBRATE_OCLOCK=1
# Auto-dismiss a ringing alarm after this many minutes (default 5;
# the countdown restarts after each snooze)
ALARM_RING_MIN=5
# Night mode: inside NIGHT_START..NIGHT_END (local time, "HH:MM" or plain
# minutes-of-day) the watch wakes every NIGHT_WAKE_MIN minutes instead of
# every minute, saving battery and e-paper refreshes. Equal start/end
# disables it; start > end wraps midnight (e.g. 22:00-06:00).
# NIGHT_WAKE_MIN is 1..60. An enabled alarm still rings on time.
NIGHT_START=00:00
NIGHT_END=06:00
NIGHT_WAKE_MIN=30
# 1 = keep radios off at night: automatic weather/NTP Wi-Fi use is skipped
# inside the night window (manual menu actions still work); 0 = normal.
NIGHT_NO_WIRELESS=0
# 1 = a wrist flick wakes the watch and redraws the face if the last update
# was >= WRIST_REFRESH_MIN_S ago (NIGHT_WAKE_MIN minutes inside the night
# window). Screen-only: the wireless sync schedule is not touched.
# NOTE: enabling it drains the battery noticeably — every accelerometer
# interrupt is a full CPU wake (~1.5 s boot cycle).
WRIST_REFRESH=0
WRIST_REFRESH_MIN_S=60
